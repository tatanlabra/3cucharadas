direction: down

classes: {
  trident: {
    style.fill: "#102b21"
    style.stroke: "#39f59a"
    style.stroke-width: 3
    style.font-color: "#f1fff8"
    style.font-size: 16
    style.border-radius: 10
  }
  board: {
    style.fill: "#0d2440"
    style.stroke: "#24c8ff"
    style.stroke-width: 3
    style.font-color: "#f2fbff"
    style.font-size: 16
    style.border-radius: 10
  }
  router: {
    style.fill: "#332817"
    style.stroke: "#ffca5c"
    style.stroke-width: 3
    style.font-color: "#fff8e8"
    style.font-size: 16
    style.border-radius: 10
  }
  human: {
    style.fill: "#102737"
    style.stroke: "#75f5bd"
    style.stroke-width: 4
    style.font-color: "#f3fffb"
    style.font-size: 17
    style.border-radius: 12
  }
}

pares: "1. EL TRIDENTE OPERATIVO\nTres agentes pares + apoyos" {
  direction: down
  style.fill: "#081a14"
  style.stroke: "#39f59a"
  style.stroke-width: 2
  style.font-color: "#caffdf"
  style.font-size: 18
  style.border-radius: 14

  codex: "Codex (VS Code / CLI / MCP)\nEjecución y parches" {
    class: trident
  }
  claude: "Claude (CLI / Revisión)\nArquitectura y auditoría" {
    class: trident
  }
  gemini: "Gemini / Antigravity\npenta-agy directo · agy-bridge" {
    class: trident
  }
  sidecars: "Apoyos acotados\nCopilot · DeepSeek / Z.ai" {
    class: router
  }

  codex -> claude: "puente MCP / CLI" {
    style.stroke: "#39f59a"
    style.stroke-width: 2
    style.font-color: "#bdfbd7"
  }
  claude -> gemini: "revisión par" {
    style.stroke: "#39f59a"
    style.stroke-width: 2
    style.font-color: "#bdfbd7"
  }
  gemini -> sidecars: "tareas chicas" {
    style.stroke: "#ffca5c"
    style.stroke-dash: 4
    style.stroke-width: 2
    style.font-color: "#ffe4a3"
  }
}

coordinacion: "2. PIZARRA VIVA Y CONTROL\ntmux + ruteo por cuota" {
  direction: down
  style.fill: "#09182b"
  style.stroke: "#24c8ff"
  style.stroke-width: 2
  style.font-color: "#cdefff"
  style.font-size: 18
  style.border-radius: 14

  mrouter: "model_router + quota-guard\n42/42 pruebas · deriva 1,00" {
    class: router
  }
  planboard: "plan-board en tmux\nPLAN_STATE v2 compartido" {
    class: board
  }
  dgate: "decision-gate\nOpción recomendada + evidencia" {
    class: board
  }
  humano: "Persona usuaria\nAutoridad final de cierre" {
    class: human
  }

  mrouter -> planboard: "salud y cuota" {
    style.stroke: "#ffca5c"
    style.stroke-width: 2
    style.font-color: "#ffe4a3"
  }
  planboard -> dgate: "bloqueo material" {
    style.stroke: "#24c8ff"
    style.stroke-width: 2
    style.font-color: "#bfeaff"
  }
  dgate -> humano: "decisión trazable" {
    style.stroke: "#75f5bd"
    style.stroke-width: 3
    style.font-color: "#d1ffec"
  }
}

pares -> coordinacion: "HANDOFF-TRACE" {
  style.stroke: "#24c8ff"
  style.stroke-width: 3
  style.font-color: "#bfeaff"
}
