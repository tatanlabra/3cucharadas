#!/usr/bin/env bash
# Frena un push que lleve secretos, antes de que salga hacia GitLab y GitHub.
#
# `origin` tiene dos pushurl y empuja primero a GitLab (producción, repo público) y
# después a GitHub; el push no es atómico. El bloqueo de pushes de GitHub (push
# protection) llega tarde: GitLab ya aceptó y publicó el commit. Este hook es el único
# punto común a los dos remotos. Escanea con gitleaks solo los commits que salen.
#
# Saltarlo (`git push --no-verify`) es una decisión humana, no de un agente.
# Instalar con scripts/install_git_hooks.sh; ver scripts/git-hooks/README.md.
set -uo pipefail

remote="${1:-origin}"
url="${2:-$remote}"
zero=0000000000000000000000000000000000000000

if ! command -v gitleaks >/dev/null 2>&1; then
  printf 'pre-push: falta gitleaks (sudo pacman -S --needed gitleaks); push detenido.\n' >&2
  exit 1
fi

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # borrado de una rama remota: no sale contenido
  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    # Rama nueva, o el remoto tiene commits que aquí no están: lo que no conoce ningún remoto.
    range="${local_sha} --not --remotes=${remote}"
  else
    range="${remote_sha}..${local_sha}"
  fi
  if ! gitleaks git --log-opts="$range" --redact --verbose --no-banner --log-level warn --exit-code 1 >&2; then
    status=1
  fi

  # Gate de promoción Draft -> Post: audita cualquier post nuevo o modificado en _posts/ o _drafts/
  repo_root="$(git rev-parse --show-toplevel)"
  if [ -f "$repo_root/scripts/verify_draft_promotion.rb" ]; then
    while IFS= read -r touched_md; do
      [ -z "$touched_md" ] && continue
      [ ! -f "$repo_root/$touched_md" ] && continue
      if ! ruby "$repo_root/scripts/verify_draft_promotion.rb" "$repo_root/$touched_md" >&2; then
        printf 'pre-push: verify_draft_promotion.rb rechazó %s; corrige atribución/frontmatter/estilo antes de empujar.\n' "$touched_md" >&2
        status=1
      fi
    done < <(git log --name-only --diff-filter=AM --pretty=format: $range -- '_posts/*.md' '_drafts/*.md' | sort -u)
  fi
done

if [ "$status" -ne 0 ]; then
  printf 'pre-push: gitleaks encontró posibles secretos en %s hacia %s; push detenido antes de\n' "$local_ref" "$url" >&2
  printf 'llegar a GitLab o a GitHub. Quitar el secreto reescribiendo el commit, rotarlo si ya\n' >&2
  printf 'existía en otra parte, y volver a empujar. Un falso positivo va a .gitleaksignore.\n' >&2
fi
exit "$status"
